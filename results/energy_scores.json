  "definitions": {
    "observation_distance": "Weighted mean distance from observations to generated samples",
    "half_sample_distance": "Half the mean distance between distinct pairs of generated samples",
    "energy_score": "observation_distance minus half_sample_distance; lower is better",
    "PPCA": "Each neural fit's mean score across streams minus the PPCA mean at the same observation variance; the models use separate sampling streams",
    "covariance": "Fraction of transformed covariance trace contributed by the first sixteen eigenvectors of the original weighted training covariance, using the same eigenvectors for each transformation",
    "reduction": "Average the three sampling streams within each fit before computing counts and ranges across fits",
    "variance_refit": "Score after replacing observation variance minus the original score, using the same network weights and sampling stream",
    "scope": "Scores use normalized coordinates and finite generated samples; comparisons describe the available fits",
    "skip": "skip_base minus no_skip_base, or skip_high minus no_skip_high, at the same observation variance and training and sampling seeds"
  },
  "limits": [
